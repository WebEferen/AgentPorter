{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPorter target language selection (.porter/target.json)",
  "type": "object",
  "required": ["schema", "context", "weights", "candidates", "recommended"],
  "properties": {
    "schema": {"const": 1},
    "context": {"type": "object"},
    "userInputs": {"type": "object"},
    "weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "scores", "total", "evidence"],
        "properties": {
          "language": {"type": "string", "minLength": 1},
          "registry": {"type": ["string", "null"]},
          "scores": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 5}},
          "total": {"type": ["number", "null"]},
          "evidence": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "blockers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommended": {"type": "string"},
    "chosen": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"]}
  }
}
