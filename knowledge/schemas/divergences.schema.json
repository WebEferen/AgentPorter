{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPorter intentional divergences (.porter/divergences.json)",
  "type": "object",
  "required": ["schema", "divergences"],
  "properties": {
    "schema": {"const": 1},
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "unit", "summary", "rationale", "cases"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "unit": {"type": "string"},
          "summary": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "cases": {"type": "array", "items": {"type": "string"}},
          "approvedBy": {"type": ["string", "null"]}
        }
      }
    }
  }
}
